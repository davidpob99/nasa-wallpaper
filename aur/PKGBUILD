# Maintainer: David Población Criado <davidpblcrd@protonmail.com>
pkgname=nasa-wallpaper
pkgver=2.1.1
pkgrel=2
pkgdesc="Imposta lo sfondo del desktop con un'immagine NASA (APOD, Image Library o Unsplash)"
arch=('i686' 'x86_64' 'aarch64' 'arm')
url="https://github.com/davidpob99/nasa-wallpaper"
license=('Apache-2.0')
depends=('glibc')
source=(
  "https://github.com/davidpob99/nasa-wallpaper/releases/download/v${pkgver}/nasa-wallpaper-Linux-i686-gnu.tar.gz"
  "https://github.com/davidpob99/nasa-wallpaper/releases/download/v${pkgver}/nasa-wallpaper-Linux-x86_64-gnu.tar.gz"
  "https://github.com/davidpob99/nasa-wallpaper/releases/download/v${pkgver}/nasa-wallpaper-Linux-aarch64-gnu.tar.gz"
  "https://github.com/davidpob99/nasa-wallpaper/releases/download/v${pkgver}/nasa-wallpaper-Linux-arm-gnu.tar.gz"
)
sha256sums=(
  '5dda78c6e75624a4bec1fc40a13ff7125c2ef642cc36701c72a7077b14312a57'
  '222b0f08e47f837499a3b17ffb7b157c24447fc4ad41fe0cf8171650d7e8e526'
  'c23a7fc0af3d67065de3a458bff1e22925f6157fac739d82a7e6f4765fdfd7a4'
  '43208b22aca899d266ba5edd6a95b930429a0ee6885d5f9a046edfc909d3ef5b'
)

package() {
  case "$(uname -m)" in
    x86_64) asset='nasa-wallpaper-Linux-x86_64-gnu.tar.gz' ;;
    i686|i386) asset='nasa-wallpaper-Linux-i686-gnu.tar.gz' ;;
    aarch64|arm64) asset='nasa-wallpaper-Linux-aarch64-gnu.tar.gz' ;;
    arm*) asset='nasa-wallpaper-Linux-arm-gnu.tar.gz' ;;
    *) echo "Architettura non supportata" >&2; return 1 ;;
  esac

  tar -xf "$asset" -C "$srcdir" || return 1
  install -Dm755 "$srcdir/nasa-wallpaper" "$pkgdir/usr/bin/nasa-wallpaper"
}
